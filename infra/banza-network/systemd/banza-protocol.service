# /etc/systemd/system/banza-protocol.service — bring the stack up on boot.
# enable: systemctl enable --now banza-protocol.service
[Unit]
Description=BANZA protocol stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/banza-protocol
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
User=banza
Group=docker

[Install]
WantedBy=multi-user.target
