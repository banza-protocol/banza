# BANZA dedicated stack — secrets template. COPY to .env (chmod 600), fill values, NEVER commit .env.
# No production signing keys here. No operator secrets. This VM serves public artifacts only.

# ── Image tags (fixed; no :latest) — from CI/GHCR ──
WEBSITE_TAG=v1.0.0
VERIFICATION_TAG=v0.1.0
BANZAI_TAG=v0.1.0

# ── Build source (only relevant for a local `docker compose build`) ──
# build.context uses ${BANZA_REPO}; when unset it defaults to /srv/banza-protocol/repo
# (the VM layout), so `docker compose build website` works on the VM with NO .env change.
# For a local build, set BANZA_REPO to your repo root. Not a secret.
# BANZA_REPO=/srv/banza-protocol/repo

# ── PostgreSQL (internal only; never exposed) ──
PG_ADMIN_PASSWORD=change-me-strong
PG_RO_PASSWORD=change-me-strong
PG_GOV_PASSWORD=change-me-strong
PG_BANZAI_PASSWORD=change-me-strong

# ── BanzAI LLM — provider selection ──
# Allowlist: mock | deepseek | qwen | local_qwen. Any other value refuses to start.
#   mock       → deterministic offline answers (default for local/tests)
#   deepseek   → hosted DeepSeek chat API (off-host inference)
#   qwen       → hosted Qwen (DashScope) chat API (off-host inference)
#   local_qwen → INTERNAL llama.cpp OpenAI-compatible endpoint (ADR-044): on-host CPU
#                inference, no key, no GPU, nothing leaves the host. Requires the
#                "llama-local" compose profile + a manually installed GGUF. Benchmark-
#                gated: never the effective default until the VPS XL+ benchmark approves it.
#                local_qwen REFUSES an off-host LLM_API_BASE (must stay on-host).
# A hosted API key lives ONLY in the VM's .env (chmod 600) — never in Git, never in logs.
LLM_PROVIDER=mock
LLM_API_KEY=change-me            # hosted providers only; leave empty/unset for local_qwen
LLM_MODEL=change-me              # provider chat model (adapter has a safe default per provider)
LLM_API_BASE=change-me           # provider public API base (adapter has a safe default per provider)
# ADR-045: leave these UNSET so the app applies the per-destination default —
# local_qwen → 384 tokens / 60000ms (professional + margin; ADR-047); hosted → 800 / 30000ms.
# Uncomment ONLY to force an explicit override (it then wins for every provider).
# LLM_TIMEOUT_MS=60000           # optional override (ms)
# LLM_MAX_TOKENS=384             # optional override (completion cap)
LLM_TEMPERATURE=0.2
LLM_TOP_P=                       # optional conservative sampling for local_qwen (e.g. 0.8)
EMBEDDING_MODEL=qwen3-embedding  # or bge-m3 (dim must match schema vector(1024))

# ── BanzAI cost control — the LLM is the LAST resort, never the first ──
# Pipeline: deterministic answers → exact cache → semantic cache → budget gate →
# limited RAG + LLM → post-validation. Past budget BanzAI answers only from
# deterministic entries and caches; it NEVER calls DeepSeek/Qwen over budget.
BANZAI_ANSWER_MODE=fast          # fast (default: fewer chunks, tighter tokens) | deep
# SPR-4 §5 structured generation: the model authors only the linguistic core; cited_source_ids is derived
# deterministically (⊆ allowed). 1 = on (prod default since 2026-08-07, A/B-gated); unset/0 = baseline.
BANZAI_STRUCTURED_SYNTHESIS=1
LLM_MAX_CHUNKS=3                 # max retrieved excerpts sent as context
LLM_MAX_CONTEXT_CHARS=6000       # hard cap on context characters
LLM_DAILY_BUDGET_USD=1.00        # daily ceiling for estimated LLM spend
LLM_MONTHLY_BUDGET_USD=15.00     # monthly ceiling for estimated LLM spend
LLM_COST_PER_1K_TOKENS_USD=0.0005  # blended per-1k-token rate used for estimates
BANZAI_CACHE_MAX_ENTRIES=500     # in-process answer cache size (exact + semantic)
BANZAI_CACHE_TTL_MS=86400000     # cache entry TTL (24h); corpus changes also invalidate
BANZAI_SEMANTIC_THRESHOLD=0.92   # cosine similarity needed for a semantic cache hit
RATE_LIMIT_MAX=60                # /ask requests per client per window
RATE_LIMIT_WINDOW_MS=60000       # rate-limit window

# ── BanzAI local inference (llama.cpp) — ADR-044. OPT-IN; internal-only; no GPU ──
# The default stack stays hosted/mock. To run the local model:
#   1. Install the GGUF manually into infra/banza-network/models/ (NEVER committed; see
#      docs/banzai/LOCAL_QWEN_MODEL_SETUP.md). No model is downloaded during build/deploy.
#   2. Start the profile:  COMPOSE_PROFILES=llama-local docker compose up -d llama-local
#   3. Point BanzAI at it: LLM_PROVIDER=local_qwen (LLM_API_BASE/KEY unneeded; must stay on-host).
# local_qwen is the effective default ONLY after the VPS XL+ benchmark approves it
# (set BANZAI_BENCHMARK_APPROVED=true then). Until then it is opt-in/preview; mock/degraded
# remain the fallback.
COMPOSE_PROFILES=                # set to "llama-local" to start the local model service
LLAMA_LOCAL_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:b832a7b7252a90a79a1e8d23d9be3ac5261a33224f60682dff0cade412fa55d3   # digest-pinned (ADR-045); the image the VPS XL+ benchmark validated. Override only with another @sha256 pin.
LLAMA_MODEL_PATH=/models/model.gguf  # path INSIDE the container (bind mount ./models:ro)
# Selected model: Qwen2.5-7B-Instruct Q4_K_M (benchmark selection over 14B under unchanged
# thresholds — docs/reports/M2_18B3_UNIFIED_TWO_PASS_BENCHMARK_VERDICT.md; setup:
# docs/banzai/LOCAL_QWEN_MODEL_SETUP.md). The model is a local language layer only: non-normative,
# decides nothing, and BanzAI answers deterministically without it.
BANZAI_SYNTHESIS_MODEL=qwen2.5-7b-instruct-q4_k_m
LLAMA_CTX_SIZE=4096              # 8192 only if the benchmark proves stability
LLAMA_THREADS=4
LLAMA_CPU_LIMIT=4.0             # deploy.resources.limits.cpus
LLAMA_MEM_LIMIT=7g             # deploy.resources.limits.memory — bounded so it can't OOM the host
BANZAI_MAX_CONCURRENCY=1        # local CPU inference: one request at a time
BANZAI_QUEUE_SIZE=1            # short queue; excess /ask fails fast and safe
BANZAI_LOCAL_INFERENCE_ENABLED=false
BANZAI_BENCHMARK_APPROVED=false  # flip to true ONLY after the VPS XL+ benchmark approves local_qwen
BANZAI_WARMUP=1                 # ADR-045: best-effort local warm-up on startup (set 0 to disable)
# local_qwen tuned defaults (ADR-045; override via LLM_MAX_TOKENS / LLM_TIMEOUT_MS above):
#   output 384 tokens (ADR-047) · timeout 60000ms · ≤3 sources · compact Rust prompt · reasoning off
