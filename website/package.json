{
  "name": "@banza/website",
  "version": "0.1.0",
  "private": true,
  "description": "Official BANZA protocol website (banza.network) — institutional, pt-PT, pre-production.",
  "scripts": {
    "dev": "next dev --port 3006",
    "build": "next build",
    "start": "next start --port 3006",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "check:kb": "cargo test --manifest-path ../engines/banzai-evidence/Cargo.toml --test kb",
    "check:kb:eval": "cargo test --manifest-path ../engines/banzai-evidence/Cargo.toml",
    "check:banzai": "cargo test --manifest-path ../engines/banzai-evidence/Cargo.toml"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
