    {
      "id": "RC-001",
      "title": "a receipt carrying only core reason codes",
      "field": "reason_codes",
      "input": [
        "TRUST_VALID"
      ],
      "expect": "accept",
      "note": "Core codes contain no dot."
    },
    {
      "id": "RC-002",
      "title": "multiple reason codes on one step",
      "field": "reason_codes",
      "input": [
        "host_mismatch",
        "redirect_blocked"
      ],
      "expect": "accept"
    },
    {
      "id": "RC-003",
      "title": "a failed check names a published check id",
      "field": "failed_checks",
      "input": [
        "not_revoked"
      ],
      "outcome": "FAIL_CLOSED",
      "expect": "accept"
    },
    {
      "id": "RC-004",
      "title": "an unregistered core-shaped code is preserved, never rejected",
      "field": "reason_codes",
      "input": [
        "SOME_FUTURE_CODE"
      ],
      "expect": "accept",
      "required_behaviour": "preserve; MUST NOT change any verdict; MUST NOT reject the artifact",
      "note": "Adding a core code is backward compatible (ADR-081)."
    },
    {
      "id": "RC-005",
      "title": "a valid extension code is preserved and never interpreted",
      "field": "reason_codes",
      "input": [
        "x-acme.gateway_timeout"
      ],
      "expect": "accept",
      "required_behaviour": "preserve; MUST NOT interpret; MUST NOT change any verdict"
    },
    {
      "id": "RC-006",
      "title": "an extension code with no vendor namespace is invalid",
      "field": "reason_codes",
      "input": [
        "x-.oops"
      ],
      "expect": "reject",
      "rule": "extension_namespace"
    },
    {
      "id": "RC-007",
      "title": "a dotted code that is not in the extension namespace is invalid",
      "field": "reason_codes",
      "input": [
        "acme.timeout"
      ],
      "expect": "reject",
      "rule": "extension_namespace",
      "note": "Only the x- prefix reserves a vendor space; a bare dot would collide with nothing but means nothing."
    },
    {
      "id": "RC-008",
      "title": "duplicate reason codes are not significant",
      "field": "reason_codes",
      "input": [
        "host_mismatch",
        "host_mismatch"
      ],
      "expect": "accept",
      "required_behaviour": "the set is {host_mismatch}; equivalence compares sets"
    },
    {
      "id": "RC-009",
      "title": "ordering of reason codes is not significant",
      "field": "reason_codes",
      "input_a": [
        "a_first",
        "b_second"
      ],
      "input_b": [
        "b_second",
        "a_first"
      ],
      "expect": "EQUIVALENT"
    },
    {
      "id": "RC-010",
      "title": "a duplicate in failed_checks is invalid",
      "field": "failed_checks",
      "input": [
        "not_revoked",
        "not_revoked"
      ],
      "expect": "reject",
      "rule": "failed_checks is a set expressed as an array"
    },
    {
      "id": "RC-011",
      "title": "a failed_checks value that is not a published check id is invalid",
      "field": "failed_checks",
      "input": [
        "definitely_not_a_check"
      ],
      "expect": "reject",
      "rule": "failed_checks values MUST be check ids published in contracts/federation/federation-trust.json"
    },
    {
      "id": "RC-012",
      "title": "failed_checks MUST be empty when routing is allowed",
      "field": "failed_checks",
      "outcome": "ROUTING_ALLOWED",
      "input": [
        "not_revoked"
      ],
      "expect": "reject",
      "rule": "empty iff ROUTING_ALLOWED"
    },
    {
      "id": "RC-013",
      "title": "failed_checks MUST be non-empty when fail-closed",
      "field": "failed_checks",
      "outcome": "FAIL_CLOSED",
      "input": [],
