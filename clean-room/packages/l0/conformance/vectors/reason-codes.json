      "note": "A successful artifact fetch carries no reason codes."
    },
    {
      "id": "RC-015",
      "title": "a trust_status outside the closed enum is schema-invalid",
      "field": "trust_status",
      "input": "TRUST_PROBABLY_FINE",
      "expect": "reject",
      "rule": "closed enum — the §6 tolerance for unknown codes does NOT apply to decisional statuses"
    },
    {
      "id": "RC-016",
      "title": "an extension code may not appear in a closed enum field",
      "field": "trust_status",
