+  "def-operator-vs-implementation",
+  "def-certification-actor",
+  "def-lifecycle-version",
+  "def-lifecycle-status",
+  "def-lifecycle-protocol-freeze",
+  "def-lifecycle-l0-freeze",
+  "def-lifecycle-independent-implementation",
+  "def-lifecycle-trial",
+]);
+
