  "open_findings": [
    {
      "id": "payment-brand-scan-is-normative-surface-only",
      "severity": "documentation defect, corrected; scope limit recorded",
      "pre_existing_on_origin_main": true,
      "detail": "The payment-operator brand list IS consumed — by the L1b scan, over contracts/ and conformance/ only. It is NOT repository-wide. Nine comments in banza-repo-guards claimed those brands 'stay blocked everywhere', which is false for the website surface, and my first analysis compounded it by reporting the constant as never read. Both corrected: the comments now say what the scan actually covers.",
      "consequence": "a payment-operator brand on a website page is not caught by this gate. That is the gate's designed scope, now accurately documented rather than overstated.",
      "disposition": "if repository-wide payment-brand blocking is wanted, it needs its own change with its own survey — it may surface violations outside this PR."
    },
    {
      "id": "contamination-admission-is-path-scoped-not-clause-scoped",
      "severity": "design limit of the gate, recorded",
      "detail": "the institutional-attribution allowlist admits the designated-scheme stem for a WHOLE FILE. Within an admitted page it cannot distinguish a legitimate attribution from an illegitimate claim: asserting that the scheme operates BANZA as its own payment network on the admitted English licence page does not fail the gate.",
      "consequence": "the three admissions are correctly scoped to paths whose Portuguese counterparts are already admitted, but they do inherit this limit.",
      "disposition": "clause-scoped admission would be a redesign of the gate; out of this PR's scope."
    }
  ]
}
