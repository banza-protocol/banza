{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banza.network/contracts/collections/collection-rule.schema.json",
  "title": "CollectionRule",
  "description": "Extensible split/contribution strategy for a Collection (ADR-018). A tagged strategy object (not a flat enum) so new rules are added without breaking compatibility. EQUAL_SPLIT with divisibility=EXACT forbids silent rounding.",
  "_spec_version": "1.0",
  "_status": "canonical",
  "_authority": "ADR-018",
  "type": "object",
  "required": [
    "type"
  ],
  "discriminator": {
    "propertyName": "type"
  },
  "oneOf": [
    {
      "title": "EqualSplit",
      "properties": {
        "type": {
          "const": "EQUAL_SPLIT"
        },
        "participants_count": {
          "type": "integer",
          "minimum": 2,
          "description": "N participants; total split equally.",
          "maximum": 9007199254740991
        },
        "divisibility": {
          "type": "string",
          "enum": [
            "EXACT",
            "REMAINDER_TO_FIRST"
          ],
          "default": "EXACT",
          "description": "EXACT: reject a non-divisible total (no silent rounding, INV-COLLECTION-003). REMAINDER_TO_FIRST: explicit opt-in; remainder assigned to share 1 and recorded."
        }
      },
      "required": [
        "type",
        "participants_count"
      ],
      "additionalProperties": false
    },
    {
      "title": "FixedAmounts",
      "properties": {
        "type": {
          "const": "FIXED_AMOUNTS"
        },
        "shares": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "amount_minor"
            ],
            "properties": {
              "amount_minor": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "participant": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "description": "Explicit amount per share. Sum MUST equal total_amount_minor (INV-COLLECTION-002)."
        }
      },
      "required": [
        "type",
        "shares"
      ],
      "additionalProperties": false
    },
    {
      "title": "Percentage",
      "properties": {
        "type": {
          "const": "PERCENTAGE"
        },
        "shares": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "percent"
            ],
            "properties": {
              "percent": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "participant": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "description": "Percentages MUST sum to 100; resolved amounts MUST sum to total_amount_minor in integer minor units (divisibility rule applies to any remainder)."
        }
      },
      "required": [
        "type",
        "shares"
      ],
      "additionalProperties": false
    },
    {
      "title": "OpenContribution",
      "properties": {
        "type": {
          "const": "OPEN_CONTRIBUTION"
        },
        "target_minor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Optional goal; total_amount_minor is a target, not a hard total. Open number of shares.",
          "maximum": 9007199254740991
        },
        "allow_overpay": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "title": "MinimumContribution",
      "properties": {
        "type": {
          "const": "MINIMUM_CONTRIBUTION"
        },
        "min_minor": {
          "type": "integer",
          "minimum": 1,
          "description": "Per-share floor; a share below this is rejected.",
          "maximum": 9007199254740991
        },
        "target_minor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "min_minor"
      ],
      "additionalProperties": false
    }
  ],
  "_extensibility": "New rule types are added as new oneOf branches with a new `type` const. Existing branches are never changed in a breaking way; a breaking change requires an ADR.",
  "_numeric_domain": "Integers in a signed or digested BANZA artifact are bounded by the canonicalization in force (BCJ/1: |n| <= 2^53-1, spec/canonicalization.md P2). The bound is declared here so the schema and the canonicalization cannot disagree about what is representable."
}
