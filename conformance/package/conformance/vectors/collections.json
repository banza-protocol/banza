{
  "_spec": "BANZA Collections Conformance Vectors v1.0",
  "_stability": "stable",
  "_authority": "ADR-018",
  "_capability": "supports_collections",
  "_note": "Collections is a Level-2 capability (requires supports_payment_intents). Vectors use seed wallets that exist on any freshly started sandbox operator. Amounts are within seed balances. A Collection NEVER posts to the ledger; settlement happens per share via PaymentIntent -> Transfer.",

  "vectors": [
    {
      "id": "COL-001",
      "title": "Equal split — exact divisibility success",
      "certification_level": 2,
      "stability": "stable",
      "input": {
        "method": "POST",
        "path": "/collections",
        "headers": { "Idempotency-Key": "col-001-key" },
        "body": {
          "title": "Dinner",
          "currency": "AOA",
          "total_amount_minor": 3000000,
          "rule": { "type": "EQUAL_SPLIT", "participants_count": 3, "divisibility": "EXACT" },
          "open_immediately": true
        }
      },
      "expected": {
        "status": 201,
        "response_fields_required": ["id", "status", "currency", "total_amount_minor", "rule"],
        "response_field_values": { "status": "OPEN", "currency": "AOA", "total_amount_minor": 3000000 },
        "derived": { "per_share_amount_minor": 1000000, "shares_count": 3 }
      },
      "invariants": ["INV-COLLECTION-001", "INV-COLLECTION-002", "INV-COLLECTION-003"]
    },

    {
      "id": "COL-002",
      "title": "Equal split — non-divisible total rejected (no silent rounding)",
      "certification_level": 2,
      "stability": "stable",
      "input": {
        "method": "POST",
        "path": "/collections",
        "headers": { "Idempotency-Key": "col-002-key" },
        "body": {
          "currency": "AOA",
          "total_amount_minor": 1000000,
          "rule": { "type": "EQUAL_SPLIT", "participants_count": 3, "divisibility": "EXACT" }
        }
      },
      "expected": {
        "status": 422,
        "response_field_values": { "code": "COLLECTION_INDIVISIBLE" }
      },
      "invariants": ["INV-COLLECTION-003"],
      "notes": "1000000 / 3 has a remainder; EXACT divisibility MUST reject. No rounding."
    },

    {
      "id": "COL-003",
      "title": "Fixed amounts — shares must sum to total",
      "certification_level": 2,
      "stability": "stable",
      "input": {
        "method": "POST",
        "path": "/collections",
        "headers": { "Idempotency-Key": "col-003-key" },
        "body": {
          "currency": "AOA",
          "total_amount_minor": 2500000,
          "rule": { "type": "FIXED_AMOUNTS", "shares": [ { "amount_minor": 1000000 }, { "amount_minor": 1500000 } ] }
        }
      },
      "expected": { "status": 201, "response_field_values": { "status": "OPEN" } },
      "invariants": ["INV-COLLECTION-002"]
    },

    {
      "id": "COL-004",
      "title": "Fixed amounts — sum mismatch rejected",
      "certification_level": 2,
      "stability": "stable",
      "input": {
        "method": "POST",
        "path": "/collections",
        "headers": { "Idempotency-Key": "col-004-key" },
        "body": {
          "currency": "AOA",
          "total_amount_minor": 3000000,
          "rule": { "type": "FIXED_AMOUNTS", "shares": [ { "amount_minor": 1000000 }, { "amount_minor": 1500000 } ] }
        }
      },
      "expected": { "status": 422, "response_field_values": { "code": "COLLECTION_SUM_MISMATCH" } },
      "invariants": ["INV-COLLECTION-002"]
    },

    {
      "id": "COL-005",
      "title": "Create is idempotent on Idempotency-Key",
      "certification_level": 2,
      "stability": "stable",
      "setup": [
        { "method": "POST", "path": "/collections", "headers": { "Idempotency-Key": "col-005-key" },
          "body": { "currency": "AOA", "total_amount_minor": 2000000, "rule": { "type": "EQUAL_SPLIT", "participants_count": 2 } } }
      ],
      "input": {
        "method": "POST",
        "path": "/collections",
        "headers": { "Idempotency-Key": "col-005-key" },
        "body": { "currency": "AOA", "total_amount_minor": 2000000, "rule": { "type": "EQUAL_SPLIT", "participants_count": 2 } }
      },
      "expected": { "status": 200, "assertion": "same collection id as setup; no second collection created" },
      "invariants": ["INV-COLLECTION-008"]
    },

    {
      "id": "COL-006",
      "title": "Share paid only via a real transfer; double payment rejected",
      "certification_level": 2,
      "stability": "stable",
      "requires_fresh_state": true,
      "assertion": "After a share is PAID (transfer_id set, Transfer.causation_id == share.payment_intent_id), a second payment attempt on the same share returns 409 SHARE_ALREADY_PAID. The share status is terminal PAID.",
      "expected": { "double_pay_status": 409, "double_pay_code": "SHARE_ALREADY_PAID" },
      "invariants": ["INV-COLLECTION-005", "INV-COLLECTION-006"]
    },

    {
      "id": "COL-007",
      "title": "Collection holds no balance and never posts to the ledger",
      "certification_level": 2,
      "stability": "stable",
      "assertion": "No ledger posting references a collection_id. The wallet balance change on a share payment equals exactly the share amount and is attributable to the share's Transfer, not to the Collection. collected_amount_minor == sum(PAID shares).",
      "invariants": ["INV-COLLECTION-001", "INV-COLLECTION-004"]
    },

    {
      "id": "COL-008",
      "title": "Only the owner can cancel; PAID shares are unaffected",
      "certification_level": 2,
      "stability": "stable",
      "assertion": "A non-owner cancel returns 403. An owner cancel moves the collection to CANCELLED and unpaid shares to CANCELLED, while any PAID share remains terminal PAID (settled money is not reversed here; refunds follow ADR-020).",
      "expected": { "non_owner_status": 403 }
    },

    {
      "id": "COL-009",
      "title": "Immutable fields after OPEN",
      "certification_level": 2,
      "stability": "stable",
      "assertion": "PATCH attempting to change currency/rule/total_amount_minor on an OPEN collection returns 409 COLLECTION_IMMUTABLE.",
      "expected": { "status": 409, "code": "COLLECTION_IMMUTABLE" },
      "invariants": ["INV-COLLECTION-007"]
    },

    {
      "id": "COL-010",
      "title": "Minimum contribution floor enforced",
      "certification_level": 2,
      "stability": "stable",
      "assertion": "On a MINIMUM_CONTRIBUTION collection (min_minor=500000), POST /shares with amount_minor below the floor returns 422 SHARE_BELOW_MINIMUM.",
      "expected": { "status": 422, "code": "SHARE_BELOW_MINIMUM" }
    }
  ]
}
