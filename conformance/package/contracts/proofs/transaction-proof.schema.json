{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banza.network/contracts/proofs/transaction-proof.schema.json",
  "_spec": "BANZA Transaction Proof Standard v1.0",
  "_status": "canonical",
  "_authority": "ADR-022",
  "title": "TransactionProof",
  "description": "Operator-agnostic, immutable, publicly verifiable proof that a transaction exists in an operator's ledger. The receipt is not the proof; this record is. No operator branding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proof_reference",
    "operator_id",
    "network",
    "transaction_reference",
    "amount",
    "currency",
    "status",
    "created_at",
    "proof_hash",
    "signature",
    "public_verification_url"
  ],
  "properties": {
    "proof_reference": {
      "type": "string",
      "description": "Unique, immutable, non-enumerable public reference.",
      "minLength": 6,
      "maxLength": 64
    },
    "operator_id": {
      "type": "string",
      "description": "Issuing operator id."
    },
    "network": {
      "type": "string",
      "description": "BANZA network identifier."
    },
    "transaction_reference": {
      "type": "string",
      "description": "Operator transaction reference."
    },
    "amount": {
      "type": "integer",
      "description": "Amount in minor units.",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currency": {
      "type": "string",
      "description": "ISO-4217 code.",
      "pattern": "^[A-Z]{3}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "CONFIRMED",
        "FAILED",
        "REVERSED",
        "CANCELLED",
        "EXPIRED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "payer_display": {
      "type": "string"
    },
    "payee_display": {
      "type": "string"
    },
    "ledger_reference": {
      "type": "string",
      "description": "Opaque reference to the ledger posting; never the internals."
    },
    "proof_hash": {
      "type": "string",
      "description": "Hash of the canonical payload."
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "algorithm",
        "value"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "algorithm": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "public_verification_url": {
      "type": "string",
      "format": "uri",
      "description": "Operator verification page for this proof — never the document."
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "NOT_FOUND",
        "PENDING",
        "REVERSED",
        "INVALID"
      ]
    }
  },
  "_forbidden_public_fields": [
    "wallet_id",
    "balance",
    "internal_id",
    "email",
    "phone",
    "ledger_internals",
    "private_key",
    "kyc",
    "kyb",
    "storage_key"
  ],
  "_numeric_domain": "Integers in a signed or digested BANZA artifact are bounded by the canonicalization in force (BCJ/1: |n| <= 2^53-1, spec/canonicalization.md P2). The bound is declared here so the schema and the canonicalization cannot disagree about what is representable."
}
