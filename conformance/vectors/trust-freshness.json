{
  "_spec": "BANZA Trust Freshness / Anti-Rollback Conformance Vectors",
  "_status": "canonical",
  "_authority": "spec/trust-freshness.md (ADR-085)",
  "_source_of_truth": "spec/trust-freshness.md",
  "_boundary": "These vectors exercise a STATEFUL LOCAL defence. They do not, and cannot, demonstrate transparency, cross-observer consistency, or detection of first-observation staleness — see spec/trust-freshness.md §1.",
  "protocol_version": "1.0.0",
  "ordering_members": {
    "brl": "issued_at",
    "key_manifest": "not_before",
    "signed_protocol_metadata": "issued_at"
  },
  "vector_count": 10,
  "vectors": [
    {
      "id": "TF-001",
      "title": "first observation records the mark and cannot detect staleness",
      "key": {
        "artifact_type": "brl",
        "authority_identity": "BANZA"
      },
      "prior": null,
      "offered": "2020-01-01T00:00:00Z",
      "expect": "FIRST_OBSERVATION",
      "resulting_mark": "2020-01-01T00:00:00Z",
      "note": "spec/trust-freshness.md §1 — an old but valid artifact is undetectable on first contact. Stated, not hidden."
    },
    {
      "id": "TF-002",
      "title": "equal value is accepted; re-fetching the current artifact is normal",
      "key": {
        "artifact_type": "brl",
        "authority_identity": "BANZA"
      },
      "prior": "2026-08-01T00:00:00Z",
      "offered": "2026-08-01T00:00:00Z",
      "expect": "UNCHANGED",
      "resulting_mark": "2026-08-01T00:00:00Z"
    },
    {
      "id": "TF-003",
      "title": "a newer value advances the mark",
      "key": {
        "artifact_type": "brl",
        "authority_identity": "BANZA"
      },
      "prior": "2026-08-01T00:00:00Z",
      "offered": "2026-08-02T00:00:00Z",
      "expect": "ADVANCED",
      "resulting_mark": "2026-08-02T00:00:00Z"
    },
    {
      "id": "TF-004",
      "title": "an older value is refused fail-closed",
      "key": {
        "artifact_type": "brl",
        "authority_identity": "BANZA"
      },
      "prior": "2026-08-02T00:00:00Z",
      "offered": "2026-08-01T00:00:00Z",
      "expect": "ROLLBACK",
      "reason_code": "trust_version_rollback",
      "resulting_mark": "2026-08-02T00:00:00Z",
      "note": "§3(4) — the rejection must not move the mark, or serving old artifacts would lower it."
    },
    {
      "id": "TF-005",
      "title": "the mark survives process restart",
      "key": {
        "artifact_type": "brl",
        "authority_identity": "BANZA"
      },
      "prior": "2026-08-02T00:00:00Z",
      "restart": true,
      "offered": "2026-08-01T00:00:00Z",
      "expect": "ROLLBACK",
      "reason_code": "trust_version_rollback",
      "note": "§4 — a memory-only mark is defeated by restarting the verifier."
    },
    {
      "id": "TF-006",
      "title": "concurrent acceptance keeps the maximum, in either interleaving",
      "key": {
        "artifact_type": "brl",
        "authority_identity": "BANZA"
      },
      "prior": null,
      "offered_concurrently": [
        "2026-08-06T00:00:00Z",
        "2026-08-07T00:00:00Z"
      ],
      "expect": "MARK_IS_MAX",
      "resulting_mark": "2026-08-07T00:00:00Z",
      "note": "§5 — a race must not be able to move the mark backwards."
    },
    {
      "id": "TF-007",
      "title": "the Key Manifest orders on not_before",
      "key": {
        "artifact_type": "key_manifest",
        "authority_identity": "root-key-1"
      },
      "prior": "2026-08-05T00:00:00Z",
      "offered": "2026-07-01T00:00:00Z",
      "expect": "ROLLBACK",
      "reason_code": "trust_version_rollback"
    },
    {
      "id": "TF-008",
      "title": "a different authority is an independent sequence",
      "key": {
        "artifact_type": "key_manifest",
        "authority_identity": "root-key-2"
      },
      "other_key_mark": {
        "artifact_type": "key_manifest",
        "authority_identity": "root-key-1",
        "mark": "2026-08-05T00:00:00Z"
      },
      "prior": null,
      "offered": "2026-01-01T00:00:00Z",
      "expect": "FIRST_OBSERVATION",
      "note": "§2 — artifacts of the same type from different authorities are never compared."
    },
    {
      "id": "TF-009",
      "title": "restoring stale storage cannot move a mark backwards",
      "key": {
        "artifact_type": "brl",
        "authority_identity": "BANZA"
      },
      "prior": "2026-08-09T00:00:00Z",
      "restore_value": "2026-08-01T00:00:00Z",
      "expect": "MARK_UNCHANGED",
      "resulting_mark": "2026-08-09T00:00:00Z"
    },
    {
      "id": "TF-010",
      "title": "signed protocol metadata orders on issued_at",
      "key": {
        "artifact_type": "signed_protocol_metadata",
        "authority_identity": "delegated-key-1"
      },
      "prior": "2026-08-10T00:00:00Z",
